{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "json",
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/core/**/*.ts",
    "src/state/**/*.ts",
    "src/config.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "timeoutMS": 20000,
  "jsonReporter": {
    "fileName": "reports/mutation/report.json"
  },
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  }
}
