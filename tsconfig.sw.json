{
  "compilerOptions": {
    "target": "ES2022",
    // The worker global scope is not the window. Compiling it against the DOM
    // lib is how `self.clients` and `event.respondWith` end up looking like
    // errors — and how a `document` reference ends up looking like it compiles.
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true
  },
  "include": ["src/sw.ts"]
}
