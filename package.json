{
  "name": "mealunits",
  "version": "0.1.0",
  "private": true,
  "description": "An insulin bolus calculator for one person, built as an offline-capable web app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "stryker run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "SMOKE_LAN_URL=${SMOKE_LAN_URL:-http://127.0.0.1:4173/MealUnits/} node tools/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
